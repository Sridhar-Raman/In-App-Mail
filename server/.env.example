# Copy to .env and fill in.
PORT=5000
# Local MongoDB, or an Atlas string: mongodb+srv://<user>:<password>@<cluster>/sricr_inapp_mail
MONGODB_URI=mongodb://127.0.0.1:27017/sricr_inapp_mail
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# The website address(es), comma-separated. On Render set your Vercel address here.
CLIENT_ORIGIN=http://localhost:5173
# Production on Render only (set in the Render dashboard, not here):
#   NODE_ENV=production
#   TRUST_PROXY=1
# Optional: seed your own account instead of the demo one (npm run seed)
# SEED_NAME=Your Name
# SEED_EMAIL=you@example.com
# SEED_PASSWORD=choose-a-password
